rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow create: if request.auth != null && request.auth.uid == uid
     && request.resource.data.keys().hasOnly(['name','email','role','organization','createdAt'])
     && request.resource.data.keys().hasAll(['name','email','role','organization','createdAt'])
     && request.resource.data.role in ['Farmer','Industry','Government','Researcher']
     && request.resource.data.email == request.auth.token.email
     && request.resource.data.name is string && request.resource.data.name.size() <= 150
     && request.resource.data.organization is string && request.resource.data.organization.size() <= 200;
   allow update, delete: if false;
  }
 }
}
